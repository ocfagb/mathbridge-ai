# Replit configuration for MathBridge AI
run = "npm start"
modules = ["nodejs-20", "web"]

[gitHubImport]
requiredFiles = [".replit", "package.json", "server.js"]

[deployment]
run = ["npm", "start"]
deploymentTarget = "cloudrun"   # Autoscale

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
